{
  "name": "FollowUpLog",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "lead_username": {
      "type": "string"
    },
    "lead_email": {
      "type": "string"
    },
    "lead_phone": {
      "type": "string"
    },
    "sequence_id": {
      "type": "string"
    },
    "sequence_name": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "sms"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "pending"
      ],
      "default": "pending"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "lead_id",
    "sequence_id",
    "channel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}