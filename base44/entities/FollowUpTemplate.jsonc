{
  "name": "FollowUpTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template display name"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "sms"
      ],
      "default": "email",
      "description": "Delivery channel"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line (supports {{name}}, {{username}}, {{category}})"
    },
    "body": {
      "type": "string",
      "description": "Message body (supports {{name}}, {{username}}, {{email}}, {{category}}, {{status}})"
    }
  },
  "required": [
    "name",
    "channel",
    "body"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}